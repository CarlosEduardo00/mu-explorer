---
// Área de spots: os mapas na ordem do jogo (por nível), cada um com as zonas (andares, áreas) como subcategorias.
import Base from "../../layouts/Base.astro";
import SpotBar from "../../components/SpotBar.astro";
import { mapById, spotsByMap, spotsUrl, zoneSlug, fmt } from "../../lib/data";
import { mapThumb, spotBarGroups } from "../../lib/view";

const { groups, others } = spotBarGroups();
const levelsOf = (ids: string[]) => ids.flatMap((id) => (spotsByMap.get(id) ?? []).flatMap((s) => [s.level_min, s.level_max]))
  .filter((v): v is number => v != null);
const range = (lv: number[]) => (lv.length ? (Math.min(...lv) === Math.max(...lv) ? fmt(lv[0]) : `${fmt(Math.min(...lv))}–${fmt(Math.max(...lv))}`) : null);
const cards = groups.map((g) => {
  const ids = [...new Set(g.entries.map((e) => e.map_id))];
  const spots = ids.reduce((n, id) => n + (spotsByMap.get(id)?.length ?? 0), 0);
  const main = mapById.get(g.href)!;
  return { g, spots, lv: range(levelsOf(ids)), thumb: mapThumb(main), subs: g.entries.length > 1 ? g.entries : [] };
});
const otherCards = others.map((m) => ({ m, spots: spotsByMap.get(m.id)?.length ?? 0, lv: range(levelsOf([m.id])), thumb: mapThumb(m) }));
---
<Base title="Spots de farm" description="Onde upar em MU Online: spots de cada mapa com a quantidade de monstros, nível e drops." wide>
  <SpotBar />
  <h1>Spots de farm</h1>
  <p class="lead">
    Escolha o mapa: os spots aparecem no mapa do jogo com a quantidade de monstros de cada um. Mapas com andares ou
    áreas mostram cada parte separada.
  </p>

  <ul class="spot-grid">
    {cards.map(({ g, spots, lv, thumb, subs }) => (
      <li class="spot-card">
        <a class="spot-card-main" href={spotsUrl(g.href)}>
          <span class="map-card-img">{thumb ? <img src={thumb} alt="" loading="lazy" /> : <span class="ph"></span>}</span>
          <span class="map-card-body">
            <b>{g.name}</b>
            <small>{fmt(spots)} spots{lv && <> · nv {lv}</>}</small>
          </span>
        </a>
        {subs.length > 0 && (
          <ul class="spot-subs">
            {subs.map((e) => <li><a href={`${spotsUrl(e.map_id)}${e.zone ? `?zona=${zoneSlug(e.zone)}` : ""}`}>{e.label}</a></li>)}
          </ul>
        )}
      </li>
    ))}
  </ul>

  {otherCards.length > 0 && (
    <>
      <h2 id="outros">Outros mapas</h2>
      <ul class="spot-grid">
        {otherCards.map(({ m, spots, lv, thumb }) => (
          <li class="spot-card">
            <a class="spot-card-main" href={spotsUrl(m.id)}>
              <span class="map-card-img">{thumb ? <img src={thumb} alt="" loading="lazy" /> : <span class="ph"></span>}</span>
              <span class="map-card-body"><b>{m.name}</b><small>{fmt(spots)} spots{lv && <> · nv {lv}</>}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>

<style>
  .spot-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr)); gap: .7rem; }
  @media (max-width: 36rem) { .spot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; } .spot-card .map-card-body b { font-size: .95rem; } }
  .spot-card { display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: border-color .15s; }
  .spot-card:hover { border-color: rgba(214,165,74,.6); }
  .spot-card-main { display: flex; flex-direction: column; text-decoration: none; color: var(--fg); }
  .spot-card-main:hover { color: var(--fg); }
  .spot-card .map-card-img { aspect-ratio: 1; display: grid; place-items: center; background: #0c0e12; }
  .spot-card .map-card-img img { width: 100%; height: 100%; object-fit: contain; }
  .spot-subs { list-style: none; margin: 0; padding: 0 .7rem .7rem; display: flex; flex-wrap: wrap; gap: .3rem; }
  .spot-subs a { display: inline-block; padding: .1rem .5rem; border-radius: .35rem; border: 1px solid var(--line-2); font: 600 .78rem/1.4 var(--sans); color: var(--muted); text-decoration: none; }
  .spot-subs a:hover { color: var(--accent-2); border-color: var(--accent); }
</style>
