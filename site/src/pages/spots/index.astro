---
import Base from "../../layouts/Base.astro";
import { farmSpots, mapById, monsterById, spotsByMap, spotsUrl, fmt } from "../../lib/data";

// Mapas em ordem do spot de menor nível; dentro do mapa, spots por nível.
const byMap = new Map<string, typeof farmSpots>();
for (const s of [...farmSpots].sort((a, b) => (a.level_min ?? 0) - (b.level_min ?? 0) || a.id.localeCompare(b.id, "en", { numeric: true }))) {
  const list = byMap.get(s.map_id) ?? [];
  list.push(s);
  byMap.set(s.map_id, list);
}
// Número do spot na página do mapa (mesma ordem de spotsByMap).
const spotNumber = (s: (typeof farmSpots)[number]) => (spotsByMap.get(s.map_id) ?? []).indexOf(s) + 1;
const levelText = (s: (typeof farmSpots)[number]) =>
  s.level_min == null ? "—" : s.level_min === s.level_max ? fmt(s.level_min) : `${fmt(s.level_min)}–${fmt(s.level_max)}`;
const recommended = (mapId: string) => {
  const m = mapById.get(mapId);
  if (!m || m.level_recommended_min == null) return null;
  return `recomendado nv ${fmt(m.level_recommended_min)}${m.level_recommended_max != null ? `–${fmt(m.level_recommended_max)}` : "+"}`;
};
---
<Base title="Spots de farm" description="Onde upar em MU Online: grupos de monstros por mapa, com coordenadas e faixa de nível.">
  <h1>Spots de farm</h1>
  <p class="lead">
    Grupos de monstros próximos em cada mapa (hot spots), com coordenadas, volume e faixa de nível dos monstros.
    Eventos ficam de fora.
    Spot de farm bom depende também da classe, do equipamento e das taxas do servidor.
  </p>

  <div class="spot-filter">
    <label>Seu nível <input id="char-level" type="number" min="1" step="1" inputmode="numeric" placeholder="ex.: 80" /></label>
    <label>Níveis abaixo <input id="below" type="number" min="0" step="1" value="15" inputmode="numeric" /></label>
    <label>Níveis acima <input id="above" type="number" min="0" step="1" value="5" inputmode="numeric" /></label>
  </div>
  <p class="count" id="spot-count">{fmt(farmSpots.length)} spots em {fmt(byMap.size)} mapas</p>

  {[...byMap.entries()].map(([mapId, spots]) => (
    <section class="spot-map-section" data-map>
      {mapById.get(mapId)?.image_url && <img class="spot-map-thumb" src={mapById.get(mapId)?.image_url} alt="" loading="lazy" />}
      <h2><a href={spotsUrl(mapId)}>{spots[0].map_name}</a>{recommended(mapId) && <span class="rec"> · {recommended(mapId)}</span>}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Spot</th><th>Coordenadas</th><th class="num">Nível</th><th>Monstros</th></tr></thead>
          <tbody>
            {spots.map((s) => (
              <tr data-min={s.level_min ?? ""} data-max={s.level_max ?? ""}>
                <td><a href={spotsUrl(mapId, spotNumber(s))}>spot {spotNumber(s)}</a> <span class={`heat-tag heat-${s.heat ?? "mid"}`}>x{s.total}</span></td>
                <td>{s.x}, {s.y}<span class="muted"> ({s.x_min},{s.y_min})–({s.x_max},{s.y_max})</span></td>
                <td class="num">{levelText(s)}</td>
                <td>{s.monsters.map((m, i) => <>{i > 0 && ", "}<a href={`/monstros/${m.monster_id}/`} class="name-cell">{monsterById.get(m.monster_id)?.image_url && <img class="thumb" src={monsterById.get(m.monster_id)?.image_url} alt="" loading="lazy" />}{m.name}</a> ×{m.count}</>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Base>

<style>
  .spot-filter { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin: 1rem 0 .25rem; }
  .spot-filter label { display: flex; flex-direction: column; gap: .2rem; font-size: .85rem; color: var(--muted); }
  .spot-filter input { font: inherit; width: 7rem; color: var(--fg); background: var(--panel); border: 1px solid var(--line); border-radius: .4rem; padding: .4rem .6rem; }
  td .muted { font-size: .8rem; }
  .rec { font-size: .85rem; font-weight: 400; color: var(--muted); }
  .spot-map-thumb { display: block; width: 100%; max-height: 9rem; object-fit: cover; border-radius: .5rem; margin-top: 2rem; }
  .spot-map-thumb + h2 { margin-top: .5rem; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>("tr[data-min]")];
  const sections = [...document.querySelectorAll<HTMLElement>("[data-map]")];
  const count = document.getElementById("spot-count") as HTMLElement;
  const total = rows.length;

  function apply() {
    const level = Number($("char-level").value);
    const below = Math.max(0, Number($("below").value) || 0);
    const above = Math.max(0, Number($("above").value) || 0);
    let shown = 0;
    for (const row of rows) {
      const min = Number(row.dataset.min), max = Number(row.dataset.max);
      // Spot serve se algum monstro dele está na faixa [nível - abaixo, nível + acima].
      const ok = !level || (row.dataset.min !== "" && max >= level - below && min <= level + above);
      row.hidden = !ok;
      if (ok) shown++;
    }
    for (const section of sections) section.hidden = !section.querySelector("tr[data-min]:not([hidden])");
    count.textContent = level ? `${shown.toLocaleString("pt-BR")} de ${total.toLocaleString("pt-BR")} spots para o nível ${level}` : `${total.toLocaleString("pt-BR")} spots`;
  }
  for (const id of ["char-level", "below", "above"]) $(id).addEventListener("input", apply);
</script>
