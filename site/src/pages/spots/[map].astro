---
// Spots de um mapa: barra de mapas, abas das zonas (andares, áreas) e o mapa interativo com a lista de spots.
import Base from "../../layouts/Base.astro";
import SpotBar from "../../components/SpotBar.astro";
import MapExplorer from "../../components/MapExplorer.astro";
import { maps, mapById, spotsByMap, markersByMap, terrainByMap, spotMapIds, spotsUrl, fmt } from "../../lib/data";
import { spotBarGroups } from "../../lib/view";

export function getStaticPaths() {
  return spotMapIds.map((id) => ({ params: { map: id } }));
}
const map = mapById.get(Astro.params.map as string)!;
const spots = spotsByMap.get(map.id) ?? [];
const group = spotBarGroups().groups.find((g) => g.entries.some((e) => e.map_id === map.id));
const parent = map.parent_id && spotMapIds.includes(map.parent_id) ? mapById.get(map.parent_id) : undefined;
// Sem grupo do guia, os andares (mapas filhos) viram as abas.
const entries = group?.entries ?? (() => {
  const floors = maps.filter((m) => m.parent_id === map.id && spotMapIds.includes(m.id));
  return floors.length ? [{ label: map.name, map_id: map.id, zone: null }, ...floors.map((f) => ({ label: f.name, map_id: f.id, zone: null }))] : [];
})();
const levels = spots.flatMap((s) => [s.level_min, s.level_max]).filter((v): v is number => v != null);
const range = (a: number, b: number) => (a === b ? fmt(a) : `${fmt(a)}–${fmt(b)}`);
const monsterCount = spots.reduce((n, s) => n + s.total, 0);
---
<Base title={`Spots de ${map.name}`} description={`Spots de farm em ${map.name}: onde ficam, quantos monstros há em cada um, nível e drops.`} wide>
  <SpotBar mapId={map.id} />
  <header class="spot-head">
    <div class="spot-title">
      <h1>{group && group.name !== map.name && <span class="spot-group">{group.name} ›</span>}{!group && parent && <span class="spot-group">{parent.name} ›</span>}{map.name}</h1>
      <ul class="chips">
        <li class="chip">{spots.length > 0 ? `${fmt(spots.length)} spots · ${fmt(monsterCount)} monstros` : "Sem spots de farm conhecidos"}</li>
        {levels.length > 0 && <li class="chip">Monstros: nível {range(Math.min(...levels), Math.max(...levels))}</li>}
        {map.level_required != null && <li class="chip gold">Entrada: nível {fmt(map.level_required)}</li>}
      </ul>
    </div>
    <a class="btn ghost" href={`/mapas/${map.id}/`}>Informações do mapa →</a>
  </header>

  <MapExplorer mapId={map.id} mapName={map.name} spots={spots} markers={markersByMap.get(map.id) ?? []}
    minimap={map.minimap_url} terrain={terrainByMap.get(map.id) ?? null} entries={entries} />
</Base>
<style>
  .spot-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1.5rem; margin-bottom: .8rem; }
  .spot-title { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1rem; }
  .spot-head h1 { margin: 0; font-size: clamp(1.5rem, 3.5vw, 2rem); }
  .spot-group { color: var(--muted); font-size: .7em; margin-right: .4rem; }
  @media (max-width: 36rem) { .spot-head .btn { padding: .3rem .7rem; font-size: .88rem; } }
</style>
