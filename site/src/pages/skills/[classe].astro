---
// Skills de uma classe, agrupadas por como se aprendem; cada skill tem âncora (/skills/<classe>/#<skill>), usada
// pelas builds e pela página do item que ensina a skill.
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import SkillCard from "../../components/SkillCard.astro";
import { rulesets, skills, fmt } from "../../lib/data";
import { LEARN_GROUPS, learnGroup } from "../../lib/skills";

export function getStaticPaths() {
  const classes = rulesets[0]?.classes ?? [];
  return classes.filter((c) => skills.some((s) => s.class_id === c.id)).map((c) => ({ params: { classe: c.id }, props: { cls: c } }));
}
const { cls } = Astro.props;
const all = rulesets[0].classes.filter((c) => skills.some((s) => s.class_id === c.id));
const list = skills.filter((s) => s.class_id === cls.id).sort((a, b) => a.order - b.order);
const groups = LEARN_GROUPS.map((g) => ({ ...g, list: list.filter((s) => learnGroup(s) === g.id) })).filter((g) => g.list.length);
const withItem = list.filter((s) => s.learn.method === "item").length;
const fromSeason = list.some((s) => s.season);
---
<Base title={`Skills · ${cls.name}`} description={`Skills de ${cls.name} em MU Online: requisitos, como aprender e onde dropa o item de cada skill.`} wide>
  <PageHead crumbs={[{ href: "/skills/", label: "Skills" }, { label: cls.name }]} title={cls.name} image={cls.image_url}>
    <ul class="chips">
      <li class="chip">{fmt(list.length)} skills</li>
      {withItem > 0 && <li class="chip gold">{fmt(withItem)} aprendidas com item</li>}
    </ul>
  </PageHead>

  <nav class="class-pick" aria-label="Classes">
    {all.map((c) => (
      <a href={`/skills/${c.id}/`} aria-current={c.id === cls.id ? "page" : undefined}>
        {c.image_url ? <img src={c.image_url} alt="" loading="lazy" /> : <span class="ph"></span>}<span>{c.name}</span>
      </a>
    ))}
  </nav>

  {groups.length > 1 && (
    <nav class="group-jump" aria-label="Grupos">
      {groups.map((g) => <a class="chip" href={`#g-${g.id}`}>{g.label} <span class="muted">{g.list.length}</span></a>)}
    </nav>
  )}
  {fromSeason && (
    <p class="muted small">Skills com a etiqueta S21: requisitos e custos da Season 21. Podem variar um pouco entre seasons.</p>
  )}

  {groups.map((g) => (
    <section class="skill-group" id={`g-${g.id}`}>
      <h2>{g.label}</h2>
      <p class="muted small">{g.text}</p>
      <div class="skill-list">
        {g.list.map((s) => <SkillCard skill={s} />)}
      </div>
    </section>
  ))}
</Base>

<style>
  .class-pick { display: flex; gap: .4rem; overflow-x: auto; padding: .1rem 0 .5rem; margin: 0 0 .75rem; scrollbar-width: thin; }
  .class-pick a { display: inline-flex; flex: none; align-items: center; gap: .35rem; padding: .2rem .6rem .2rem .25rem; border: 1px solid var(--line); border-radius: 2rem; background: var(--panel); color: var(--fg); text-decoration: none; font-size: .85rem; white-space: nowrap; }
  .class-pick a:hover { border-color: var(--accent); }
  .class-pick a[aria-current] { border-color: var(--accent); color: var(--accent-2); }
  .class-pick img, .class-pick .ph { width: 26px; height: 26px; object-fit: contain; }
  .group-jump { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0 0 .5rem; }
  .group-jump .muted { font-size: .75rem; }
  .skill-group { margin-top: 1.25rem; scroll-margin-top: 5rem; }
  .skill-group h2 { margin-bottom: .15rem; }
  /* colunas (alvenaria): cartões de alturas diferentes sem buracos entre eles */
  .skill-list { columns: 3 22rem; column-gap: .7rem; margin-top: .6rem; }
  .skill-list > :global(.skill) { break-inside: avoid; margin-bottom: .7rem; }
  @media (pointer: coarse) { .class-pick a { min-height: 2.5rem; } }
</style>
