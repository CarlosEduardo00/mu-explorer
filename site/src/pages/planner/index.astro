---
import Base from "../../layouts/Base.astro";
---
<Base title="Planner de builds" description="Monte a sua build de MU Online: classe, nível, pontos de atributo e equipamento, com os requisitos conferidos.">
  <h1>Planner de builds</h1>
  <p class="lead">
    Ferramenta para <strong>criar a sua build</strong>: escolha a classe e o nível, distribua os pontos de atributo
    (do zero ou a partir de uma build pronta), monte o equipamento e veja na hora se dá para usar cada peça.
    No fim, copie o link para salvar ou compartilhar a build.
  </p>
  <ol class="steps">
    <li><strong>Classe e nível</strong>: as regras de pontos por nível e a evolução da classe.</li>
    <li><strong>Pontos</strong>: digite quanto colocar em cada atributo, ou escolha uma build pronta para distribuir por nível.</li>
    <li><strong>Equipamento</strong>: arma, escudo, armadura, asas, colar e anéis; os requisitos são os do item +0, sem opções nem joias.</li>
  </ol>

  <noscript><p class="warn">O planner precisa de JavaScript.</p></noscript>
  <p id="planner-loading" class="muted">Carregando…</p>

  <div id="planner" class="planner" hidden>
    <div class="planner-controls">
      <label>Regras <select id="ruleset"></select></label>
      <label>Nível <input id="level" type="number" min="1" step="1" inputmode="numeric" /></label>
      <label>Pontos extras <input id="extra" type="number" min="0" step="1" inputmode="numeric" title="Quests, frutas e outras fontes" /></label>
    </div>
    <p id="ruleset-note" class="muted"></p>

    <h2>Classe</h2>
    <div id="classes" class="chips" role="radiogroup" aria-label="Classe"></div>
    <p id="class-note" class="muted"></p>
    <div id="evolutions" class="evolutions"></div>

    <h2>Build</h2>
    <div class="planner-controls">
      <label>Build pronta <select id="build"></select></label>
    </div>
    <div id="build-info"></div>

    <h2>Atributos</h2>
    <div class="table-wrap">
      <table id="stats">
        <thead><tr><th>Atributo</th><th class="num">Base</th><th class="num">Adicionar</th><th class="num">Total</th><th></th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p id="points-summary" class="points"></p>

    <h2>Equipamento</h2>
    <div class="planner-controls gear-filters">
      <label><span>Qualidade</span>
        <select id="gear-grade">
          <option value="">Todas</option><option value="normal">Normal</option><option value="excellent">Excellent</option>
          <option value="ancient">Ancient</option><option value="socket">Socket</option>
        </select>
      </label>
      <label class="check"><input id="gear-level" type="checkbox" /> Só o que dá para usar no nível escolhido</label>
    </div>
    <div id="gear" class="gear"></div>
    <div id="gear-check"></div>

    <section id="curve-section" hidden>
      <h2>Curva por nível</h2>
      <p class="muted">Como a build distribui os pontos ao subir de nível (atributos totais, com a base).</p>
      <div id="curve-chart"></div>
      <div class="table-wrap"><table id="curve"></table></div>
    </section>

    <p><button id="share" type="button" class="btn">Copiar link desta build</button> <span id="share-msg" class="muted" role="status"></span></p>
  </div>
</Base>

<style is:global>
  .planner-controls { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin: 1rem 0 .25rem; }
  .planner-controls label { display: flex; flex-direction: column; gap: .2rem; font-size: .85rem; color: var(--muted); }
  .planner select, .planner input[type="number"] { font: inherit; color: var(--fg); background: var(--panel); border: 1px solid var(--line); border-radius: .4rem; padding: .4rem .6rem; }
  .planner input[type="number"] { width: 7rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip { font: inherit; cursor: pointer; padding: .3rem .8rem; border-radius: 1rem; border: 1px solid var(--line); background: var(--panel); color: var(--fg); }
  .chip[aria-checked="true"] { border-color: var(--accent); color: var(--accent); font-weight: 600; }
  .chip.with-img { display: inline-flex; align-items: center; gap: .35rem; padding-left: .3rem; }
  .chip img { width: 26px; height: 26px; object-fit: contain; border-radius: 50%; background: #12131a; }
  .evolutions { display: flex; gap: .5rem; overflow-x: auto; padding: .25rem 0 .5rem; }
  .evolutions figure { margin: 0; flex: 0 0 6.5rem; text-align: center; font-size: .8rem; }
  .evolutions img, .evolutions .noimg { display: block; width: 6.5rem; height: 6.5rem; object-fit: contain; background: #12131a; border-radius: .5rem; }
  .evolutions figcaption { margin-top: .25rem; line-height: 1.25; }
  .btn { font: inherit; cursor: pointer; padding: .35rem .8rem; border-radius: .4rem; border: 1px solid var(--line); background: var(--panel); color: var(--fg); }
  .btn.small { padding: .15rem .5rem; font-size: .8rem; }
  .points { font-size: 1.05rem; }
  .points strong.neg { color: #b3261e; }
  .steps { margin: 0 0 1rem; padding-left: 1.25rem; color: var(--muted); font-size: .92rem; }
  .steps strong { color: var(--fg); }
  .gear-filters { margin-top: 0; }
  #gear-check { margin-top: 1rem; }
  .gear-filters .check { flex-direction: row; align-items: center; gap: .4rem; align-self: flex-end; }
  .gear { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .6rem 1rem; }
  .gear label { display: flex; flex-direction: column; gap: .2rem; font-size: .85rem; color: var(--muted); }
  .gear select { width: 100%; }
  .ok { color: #1a7f37; }
  .bad { color: #b3261e; font-weight: 600; }
  #stats input[type="number"] { width: 6rem; }
  #stats .btn { white-space: nowrap; }
  #stats input:disabled { opacity: .7; }
  .build-card { padding: .75rem 1rem; background: var(--panel); border: 1px solid var(--line); border-radius: .5rem; margin: .5rem 0; }
  .build-card p { margin: .25rem 0; }
  .build-card ul { margin: .25rem 0; padding-left: 1.2rem; }
  .role { display: inline-block; padding: 0 .5rem; border: 1px solid var(--line); border-radius: 1rem; font-size: .8rem; color: var(--muted); margin-left: .35rem; }
  .curve-svg { width: 100%; height: auto; max-height: 16rem; display: block; margin: .5rem 0; }
  .curve-svg text { fill: var(--muted); font-size: 11px; }
  .curve-svg .axis { stroke: var(--line); }
  .legend { display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .85rem; padding: 0; list-style: none; }
  .legend i { display: inline-block; width: .8rem; height: .2rem; vertical-align: middle; margin-right: .3rem; }
</style>

<script>
  import {
    STATS, STAT_LABELS, SLOTS, pointsAtLevel, sumAllocation, totals, usableBy, checkItem, neededByGear,
    pointsToWear, encodeState, decodeState, emptyAllocation, simulateBuild,
    type Allocation, type BuildTemplate, type ClassRules, type CurvePoint, type GearItem, type PlannerState, type Ruleset,
    type Slot, type Stat,
  } from "../../lib/planner";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fmt = (n: number) => n.toLocaleString("pt-BR");

  const [{ rulesets }, { items }, { builds }] = await Promise.all([
    fetch("/data/planner.json").then((r) => r.json() as Promise<{ rulesets: Ruleset[] }>),
    fetch("/data/planner-items.json").then((r) => r.json() as Promise<{ items: GearItem[] }>),
    fetch("/data/builds.json").then((r) => r.json() as Promise<{ builds: BuildTemplate[] }>),
  ]);
  const esc = (t: string) => t.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch] as string);
  const STAT_COLORS: Record<Stat, string> = { str: "#c2410c", agi: "#15803d", vit: "#b91c1c", ene: "#1d4ed8", cmd: "#7e22ce" };
  const gearById = new Map(items.map((i) => [i.id, i]));

  if (rulesets.length === 0) {
    $("planner-loading").textContent = "Sem regras de classes neste conjunto de dados.";
  } else {
    $("planner-loading").hidden = true;
    $("planner").hidden = false;
    start();
  }

  function start() {
    const first = rulesets[0].classes[0];
    const state: PlannerState = {
      ruleset: rulesets[0].id, classId: first.id, level: 400, extra: 0, added: emptyAllocation(), gear: {},
    };
    Object.assign(state, decodeState(location.hash));

    const rules = (): Ruleset => rulesets.find((r) => r.id === state.ruleset) ?? rulesets[0];
    const cls = (): ClassRules => rules().classes.find((c) => c.id === state.classId) ?? rules().classes[0];
    const classBuilds = (): BuildTemplate[] => builds.filter((b) => b.class_id === cls().id);
    const activeBuild = (): BuildTemplate | undefined => classBuilds().find((b) => b.id === state.build);

    // conjunto de regras: da season mais nova para a mais antiga
    const rulesetSelect = $<HTMLSelectElement>("ruleset");
    rulesetSelect.innerHTML = rulesets.map((r) => `<option value="${r.id}">${r.name}</option>`).join("");

    function normalize() {
      state.ruleset = rules().id;
      state.classId = cls().id;
      const max = cls().max_level;
      state.level = Math.min(Math.max(1, state.level || 1), max);
      if (!cls().base.cmd) state.added.cmd = 0;
      if (state.build && !activeBuild()) state.build = undefined;
    }

    function renderBuildSelect() {
      const list = classBuilds();
      const select = $<HTMLSelectElement>("build");
      select.innerHTML = `<option value="">${list.length ? "— distribuição manual —" : "sem builds prontas para esta classe"}</option>` +
        list.map((b) => `<option value="${b.id}">${esc(b.name)}${b.status === "antiga" ? " (antiga)" : ""}</option>`).join("");
      select.disabled = list.length === 0;
      select.value = state.build ?? "";
    }

    function renderBuildInfo(build: BuildTemplate | undefined) {
      const box = $("build-info");
      if (!build) {
        box.innerHTML = classBuilds().length
          ? `<p class="muted">Escolha uma build para distribuir os pontos automaticamente conforme o nível.</p>` : "";
        return;
      }
      const notes = build.notes.length ? `<ul>${build.notes.map((n) => `<li>${esc(n)}</li>`).join("")}</ul>` : "";
      box.innerHTML = `<div class="build-card">
        <p><strong>${esc(build.name)}</strong><span class="role">${esc(build.role)}</span></p>
        <p>${esc(build.summary)}</p>${notes}
        <p><a href="/builds/${build.id}/">Ver a build completa: como seguir, skills e equipamento por nível →</a></p>
        <p><button type="button" class="btn small" id="build-manual">Editar manualmente a partir daqui</button></p>
      </div>`;
    }

    function renderCurve(curve: CurvePoint[] | null) {
      const section = $("curve-section");
      if (!curve || curve.length < 2) { section.hidden = true; return; }
      section.hidden = false;
      const stats = STATS.filter((st) => st !== "cmd" || cls().base.cmd > 0);
      const w = 640, h = 220, pad = { l: 44, r: 12, t: 10, b: 24 };
      const maxLevel = curve[curve.length - 1].level;
      const maxValue = Math.max(1, ...curve.flatMap((p) => stats.map((st) => p.total[st])));
      const x = (lv: number) => pad.l + ((lv - 1) / Math.max(1, maxLevel - 1)) * (w - pad.l - pad.r);
      const y = (v: number) => h - pad.b - (v / maxValue) * (h - pad.t - pad.b);
      const lines = stats.map((st) => `<polyline fill="none" stroke="${STAT_COLORS[st]}" stroke-width="2"
        points="${curve.map((p) => `${x(p.level).toFixed(1)},${y(p.total[st]).toFixed(1)}`).join(" ")}" />`).join("");
      const ticks = [0, 0.5, 1].map((f) => Math.round(maxValue * f));
      $("curve-chart").innerHTML = `
        <svg class="curve-svg" viewBox="0 0 ${w} ${h}" role="img" aria-label="Atributos totais por nível">
          <line class="axis" x1="${pad.l}" y1="${h - pad.b}" x2="${w - pad.r}" y2="${h - pad.b}" />
          ${ticks.map((v) => `<text x="${pad.l - 6}" y="${y(v) + 4}" text-anchor="end">${fmt(v)}</text>`).join("")}
          <text x="${pad.l}" y="${h - 6}">nv 1</text><text x="${w - pad.r}" y="${h - 6}" text-anchor="end">nv ${fmt(maxLevel)}</text>
          ${lines}
        </svg>
        <ul class="legend">${stats.map((st) => `<li><i style="background:${STAT_COLORS[st]}"></i>${STAT_LABELS[st]}</li>`).join("")}</ul>`;
      $("curve").innerHTML = `<thead><tr><th class="num">Nível</th>${stats.map((st) => `<th class="num">${STAT_LABELS[st]}</th>`).join("")}<th class="num">Pontos</th></tr></thead>
        <tbody>${curve.map((p) => `<tr><td class="num">${fmt(p.level)}</td>${stats.map((st) => `<td class="num">${fmt(p.total[st])}</td>`).join("")}<td class="num">${fmt(p.points)}</td></tr>`).join("")}</tbody>`;
    }

    function renderClasses() {
      $("classes").innerHTML = rules().classes
        .map((c) => `<button type="button" role="radio" class="chip${c.image_url ? " with-img" : ""}" aria-checked="${c.id === state.classId}" data-class="${c.id}">${c.image_url ? `<img src="${esc(c.image_url)}" alt="" loading="lazy" />` : ""}${esc(c.name)}</button>`)
        .join("");
    }

    const GRADE_GROUPS: [string, string][] = [["normal", "Normal"], ["excellent", "Excellent"], ["ancient", "Ancient"],
      ["socket", "Socket"], ["siege", "Castle Siege"], ["", "Outros"]];
    function renderGearSelects() {
      const c = cls();
      const grade = ($("gear-grade") as HTMLSelectElement).value;
      const onlyLevel = ($("gear-level") as HTMLInputElement).checked;
      const html = SLOTS.map(({ id, label, accepts }) => {
        const chosen = state.gear[id];
        // O item já escolhido continua na lista mesmo que o filtro o esconda.
        const options = items
          .filter((i) => i.slot === accepts && usableBy(i, c.names))
          .filter((i) => i.id === chosen || ((!grade || (i.grade ?? "") === grade) && (!onlyLevel || i.req.level <= state.level)))
          .sort((a, b) => a.req.level - b.req.level || a.name.localeCompare(b.name));
        const opt = (i: GearItem) => `<option value="${i.id}" ${chosen === i.id ? "selected" : ""}>${esc(i.name)}${i.req.level ? ` · nv ${i.req.level}` : ""}</option>`;
        const body = GRADE_GROUPS.map(([g, name]) => {
          const list = options.filter((i) => (i.grade ?? "") === g || (g === "" && !GRADE_GROUPS.some(([x]) => x && x === i.grade)));
          return list.length ? `<optgroup label="${name} (${list.length})">${list.map(opt).join("")}</optgroup>` : "";
        }).join("");
        return `<label>${label}<select data-slot="${id}" ${options.length ? "" : "disabled"}>
          <option value="">${options.length ? `— nenhum (${options.length} opções) —` : "sem itens"}</option>${body}</select></label>`;
      }).join("");
      $("gear").innerHTML = html;
    }

    function renderStats() {
      const c = cls();
      const rows = STATS.filter((s) => s !== "cmd" || c.base.cmd > 0).map((s) => `
        <tr>
          <td>${STAT_LABELS[s]}</td>
          <td class="num">${fmt(c.base[s])}</td>
          <td class="num"><input type="number" min="0" step="1" inputmode="numeric" data-stat="${s}" value="${state.added[s]}" aria-label="Pontos em ${STAT_LABELS[s]}" ${state.build ? "disabled" : ""} /></td>
          <td class="num" data-total="${s}"></td>
          <td>${state.build ? "" : `<button type="button" class="btn small" data-rest="${s}">Resto</button>`}</td>
        </tr>`).join("");
      $("stats").querySelector("tbody")!.innerHTML = rows;
    }

    function update() {
      const c = cls();
      const r = rules();
      const base = c.base;
      const equippedNow = SLOTS.flatMap(({ id }) => {
        const item = state.gear[id] ? gearById.get(state.gear[id] as string) : undefined;
        return item ? [item] : [];
      });
      const build = activeBuild();
      let curve: CurvePoint[] | null = null;
      if (build) {
        const sim = simulateBuild(c, build, state.level, state.extra, neededByGear(equippedNow), 50);
        state.added = sim.added;
        curve = sim.curve;
        for (const st of STATS) {
          const input = document.querySelector<HTMLInputElement>(`[data-stat="${st}"]`);
          if (input) input.value = String(state.added[st]);
        }
      }
      renderBuildInfo(build);
      renderCurve(curve);
      const levelPoints = pointsAtLevel(c.points, state.level, c.max_level_points);
      const available = levelPoints + state.extra;
      const used = sumAllocation(state.added);
      const left = available - used;
      const total = totals(base, state.added);

      for (const s of STATS) {
        const cell = document.querySelector<HTMLElement>(`[data-total="${s}"]`);
        if (cell) cell.textContent = fmt(total[s]);
      }
      $("points-summary").innerHTML =
        `Pontos: <strong>${fmt(available)}</strong> (${fmt(levelPoints)} por nível${state.extra ? ` + ${fmt(state.extra)} extras` : ""}) · ` +
        `usados <strong>${fmt(used)}</strong> · ` +
        `${left >= 0 ? "sobram" : "faltam"} <strong class="${left < 0 ? "neg" : ""}">${fmt(Math.abs(left))}</strong>`;

      const tier = c.tier === 2 ? `Classe de 2º tier${c.unlock_level ? `: libera no nível ${c.unlock_level} de outro personagem` : ""}.` : "";
      const evo = c.evolutions.length ? `Evolução: ${c.evolutions.map((e) => e.name).join(" → ")}.` : "";
      // uma frase por elemento (a tradução para o inglês troca cada uma)
      $("class-note").innerHTML = [tier, evo, ...(c.notes ?? [])].filter(Boolean).map((s) => `<span>${esc(s)}</span>`).join(" ");
      $("evolutions").innerHTML = c.evolutions.some((e) => e.image_url)
        ? c.evolutions.map((e) => `<figure>${e.image_url ? `<img src="${esc(e.image_url)}" alt="${esc(e.name)}" loading="lazy" />` : `<span class="noimg"></span>`}<figcaption>${esc(e.name)}${e.level ? `<br><small>nv ${fmt(e.level)}</small>` : ""}</figcaption></figure>`).join("")
        : "";
      $("ruleset-note").textContent = r.description;
      ($("level") as HTMLInputElement).max = String(c.max_level);

      // equipamento
      const equipped = SLOTS.flatMap(({ id }) => {
        const item = state.gear[id] ? gearById.get(state.gear[id] as string) : undefined;
        return item ? [item] : [];
      });
      if (equipped.length === 0) {
        $("gear-check").innerHTML = `<p class="muted">Escolha itens para conferir os requisitos.</p>`;
      } else {
        const label = (stat: string) => (stat === "level" ? "Nível" : STAT_LABELS[stat as Stat]);
        const rows = equipped.map((item) => {
          const checks = checkItem(item, total, state.level);
          const cells = checks.length
            ? checks.map((k) => `<span class="${k.ok ? "ok" : "bad"}">${label(k.stat)} ${fmt(k.have)}/${fmt(k.need)} ${k.ok ? "✓" : "✗"}</span>`).join(" · ")
            : `<span class="muted">sem requisitos</span>`;
          const slot = SLOTS.find((x) => x.id === item.slot)?.label ?? item.slot;
          const extra = item.def ? ` · DEF ${fmt(item.def)}` : item.dmg ? ` · dano ${item.dmg[0]}–${item.dmg[1]}` : "";
          return `<tr><td>${slot}</td><td><a href="/itens/${item.id}/">${item.name}</a><span class="muted">${extra}</span></td><td>${cells}</td></tr>`;
        }).join("");
        const need = neededByGear(equipped);
        const wear = pointsToWear(need, base);
        const needs = STATS.filter((s) => need[s] > 0).map((s) => `${STAT_LABELS[s]} ${fmt(need[s])}`).join(", ");
        const verdict = wear <= used
          ? `<span class="ok">dá para vestir tudo com os pontos usados</span>`
          : `<span class="bad">faltam ${fmt(wear - used)} pontos em relação ao mínimo</span>`;
        $("gear-check").innerHTML = `
          <div class="table-wrap"><table>
            <thead><tr><th>Slot</th><th>Item</th><th>Requisitos</th></tr></thead><tbody>${rows}</tbody></table></div>
          <p>O equipamento exige ${needs || "nenhum atributo"}${need.level ? `, nível ${fmt(need.level)}` : ""}.
             Mínimo de pontos acima da base: <strong>${fmt(wear)}</strong> (você usou ${fmt(used)}): ${verdict}.</p>`;
      }
      history.replaceState(null, "", `#${encodeState(state)}`);
    }

    function fullRender() {
      normalize();
      rulesetSelect.value = state.ruleset;
      ($("level") as HTMLInputElement).value = String(state.level);
      ($("extra") as HTMLInputElement).value = String(state.extra);
      renderClasses(); renderBuildSelect(); renderStats(); renderGearSelects(); update();
    }

    rulesetSelect.addEventListener("change", () => { state.ruleset = rulesetSelect.value; fullRender(); });
    $("level").addEventListener("input", (e) => {
      state.level = Number((e.target as HTMLInputElement).value); normalize();
      if (($("gear-level") as HTMLInputElement).checked) renderGearSelects();
      update();
    });
    $("gear-grade").addEventListener("change", () => renderGearSelects());
    $("gear-level").addEventListener("change", () => renderGearSelects());
    $("extra").addEventListener("input", (e) => { state.extra = Math.max(0, Math.floor(Number((e.target as HTMLInputElement).value) || 0)); update(); });
    $("classes").addEventListener("click", (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>("[data-class]");
      if (!button) return;
      state.classId = button.dataset.class as string;
      state.added = emptyAllocation();
      state.gear = {};
      state.build = undefined;
      fullRender();
    });
    $("stats").addEventListener("input", (e) => {
      const input = e.target as HTMLInputElement;
      const stat = input.dataset.stat as Stat | undefined;
      if (!stat) return;
      state.added[stat] = Math.max(0, Math.floor(Number(input.value) || 0));
      update();
    });
    $("stats").addEventListener("click", (e) => {
      const button = (e.target as HTMLElement).closest<HTMLElement>("[data-rest]");
      if (!button) return;
      const stat = button.dataset.rest as Stat;
      const c = cls();
      const available = pointsAtLevel(c.points, state.level, c.max_level_points) + state.extra;
      const others = sumAllocation(state.added) - state.added[stat];
      state.added[stat] = Math.max(0, available - others);
      (document.querySelector(`[data-stat="${stat}"]`) as HTMLInputElement).value = String(state.added[stat]);
      update();
    });
    $("gear").addEventListener("change", (e) => {
      const select = e.target as HTMLSelectElement;
      const slot = select.dataset.slot as Slot | undefined;
      if (!slot) return;
      if (select.value) state.gear[slot] = select.value; else delete state.gear[slot];
      update();
    });
    $("build").addEventListener("change", (e) => {
      state.build = (e.target as HTMLSelectElement).value || undefined;
      renderStats(); update();
    });
    $("build-info").addEventListener("click", (e) => {
      if ((e.target as HTMLElement).id !== "build-manual") return;
      state.build = undefined;      // mantém os pontos atuais e libera a edição
      $<HTMLSelectElement>("build").value = "";
      renderStats(); update();
    });
    $("share").addEventListener("click", async () => {
      const message = $("share-msg");
      try { await navigator.clipboard.writeText(location.href); message.textContent = "Link copiado."; }
      catch { message.textContent = "Copie o endereço da barra do navegador."; }
    });

    fullRender();
  }
</script>
