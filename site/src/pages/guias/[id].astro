---
// Um guia: título, série (os outros guias dela), idioma do texto e o conteúdo em blocos.
import Base from "../../layouts/Base.astro";
import GuideText from "../../components/GuideText.astro";
import GuideBlocks from "../../components/GuideBlocks.astro";
import Flag from "../../components/Flag.astro";
import { guides } from "../../lib/data";
import { SERIES, translated, textHtml } from "../../lib/guides";

export function getStaticPaths() {
  return guides.map((g) => ({ params: { id: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props;
const series = SERIES.find((s) => s.id === guide.series);
const siblings = guide.siblings.filter((s) => guides.some((g) => g.id === s.id));
const titlePt = translated(guide.title) ?? guide.title.t;
const plain = (s: string) => s.replace(/<[^>]+>|\{\d+\}/g, "").trim();
---
<Base title={plain(titlePt)} titleEn={plain(textHtml(guide.title)).replace(/^\[Guide\]\s*/, "")} description={`${plain(titlePt)}: guia de MU Online.`}>
  <nav class="crumbs" aria-label="Trilha"><a href="/guias/">Guias</a>{series && <span>{series.label}</span>}</nav>
  <header class="g-head">
    <GuideText as="h1" text={guide.title} />
    <div class="lang-switch" role="group" aria-label="Idioma do texto">
      <button type="button" data-lang-set="pt-BR" aria-pressed="true"><Flag lang="pt-BR" /> <span data-i18n="off">Português</span></button>
      <button type="button" data-lang-set="en" aria-pressed="false"><Flag lang="en" /> English</button>
    </div>
  </header>
  <p class="g-note muted small">Tradução aproximada, não oficial. Itens de quest e termos do jogo (em destaque) ficam como no jogo.</p>
  {siblings.length > 1 && (
    <nav class="g-siblings" aria-label="Guias da série">
      {siblings.map((s) => <a href={`/guias/${s.id}/`} aria-current={s.id === guide.id ? "page" : undefined}><GuideText text={{ t: s.label }} /></a>)}
    </nav>
  )}
  <article class="guide">
    <GuideBlocks blocks={guide.blocks} />
  </article>
</Base>

<script>
  // Abas dos guias: mostra o painel escolhido (sem JS, todos aparecem).
  for (const box of document.querySelectorAll<HTMLElement>("[data-gtabs]")) {
    box.classList.add("js");
    const tabs = [...box.querySelectorAll<HTMLButtonElement>(":scope > [role=tablist] > [role=tab]")];
    const show = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        document.getElementById(t.getAttribute("aria-controls")!)?.toggleAttribute("data-open", on);
      }
    };
    tabs.forEach((t) => t.addEventListener("click", () => show(t)));
  }
</script>

<style is:global>
  .g-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1rem; }
  .g-head h1 { margin: 0; }
  .g-note { margin: .4rem 0 1rem; }
  .g-siblings { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0 0 1.25rem; }
  .g-siblings a { padding: .3rem .75rem; border-radius: .45rem; border: 1px solid var(--line-2); background: var(--panel); color: var(--muted); text-decoration: none; font-weight: 600; font-size: .9rem; }
  .g-siblings a:hover { color: var(--fg); border-color: rgba(214,165,74,.5); }
  .g-siblings a[aria-current] { color: #1a1407; background: linear-gradient(#e2b45c, #c79a45); border-color: var(--accent); }
  .guide { display: flex; flex-direction: column; gap: .9rem; }
  .guide .term { color: var(--g-excellent); font-weight: 600; }
  .guide em { font-style: normal; } .guide em.warn { color: #fbbf24; } .guide em.danger { color: #f87171; } .guide em.info { color: #7dd3fc; }
  .guide em.accent { color: var(--accent-2); }
  .g-section { margin: 1rem 0 0; }
  .g-title { margin: 0 0 .4rem; font-size: 1.05rem; color: var(--accent-2); }
  .g-p { margin: 0 0 .45rem; }
  .g-p:last-child { margin-bottom: 0; }
  .g-label { margin-top: .5rem; font-weight: 700; color: var(--accent-2); text-transform: uppercase; letter-spacing: .04em; font-size: .85rem; }
  .g-accent { color: var(--accent-2); font-weight: 600; }
  .g-danger { color: #f87171; }
  .g-level { color: var(--muted); font-size: .9rem; }
  .g-center { text-align: center; }
  .g-img { display: block; max-width: min(100%, 22rem); max-height: 14rem; margin: .3rem auto .6rem; object-fit: contain; border-radius: .4rem; }
  .g-list { margin: 0 0 .5rem; padding-left: 1.2rem; } .g-list li { margin: .15rem 0; }
  .g-table { margin: .4rem 0 .6rem; } .g-table td, .g-table th { font-size: .9rem; }
  .g-card { padding: .9rem 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); min-width: 0; }
  .g-card-quest { border-color: rgba(214,165,74,.4); background: linear-gradient(160deg, #1d2232, var(--panel)); }
  /* Cartão do NPC da quest: figura ao lado do texto (embaixo dela no celular). */
  .g-card-quest:has(> .g-img:first-child) { display: grid; grid-template-columns: minmax(6rem, 9rem) 1fr; gap: 0 1.25rem; align-items: start; }
  .g-card-quest > .g-img:first-child { grid-row: 1 / span 20; margin: 0; max-height: 13rem; }
  .g-card-quest:has(> .g-img:first-child) > :not(:first-child) { grid-column: 2; }
  @media (max-width: 36rem) {
    .g-card-quest:has(> .g-img:first-child) { grid-template-columns: 5.5rem 1fr; gap: 0 .8rem; }
    .g-card-quest > .g-img:first-child { max-height: 8rem; }
  }
  .g-card-item .g-img, .g-card-guide > .g-img:first-child { max-height: 6rem; }
  .g-card-item { text-align: center; }
  .g-card-item .g-title { font-size: .95rem; }
  .g-grid { display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr)); align-items: start; }
  .g-grid-item { grid-template-columns: repeat(auto-fill, minmax(min(10rem, 100%), 1fr)); }
  .g-tabs { margin: .4rem 0; }
  .g-tablist { display: flex; flex-wrap: wrap; gap: .3rem; border-bottom: 1px solid var(--line-2); margin-bottom: .8rem; }
  .g-tablist [role=tab] { padding: .4rem .8rem; border: 1px solid transparent; border-bottom: 0; border-radius: .45rem .45rem 0 0; background: none; color: var(--muted); font: 600 .9rem/1.3 var(--sans); cursor: pointer; margin-bottom: -1px; }
  .g-tablist [role=tab][aria-selected="true"] { color: var(--accent-2); background: var(--panel); border-color: var(--line-2); }
  .g-tabs.js > .g-panel:not([data-open]) { display: none; }
  .g-panel { display: flex; flex-direction: column; gap: .9rem; }
  .g-acc { border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
  .g-acc summary { cursor: pointer; padding: .6rem .9rem; font-weight: 700; color: var(--accent-2); }
  .g-acc-body { padding: 0 .9rem .9rem; display: flex; flex-direction: column; gap: .6rem; }
</style>
