---
// Mapa interativo de um mapa do jogo: spots de farm (toque para ver monstros, atributos e drops), spots e hot
// spots marcados no minimapa do jogo, e portais. Coordenadas do jogo (x, y) desenhadas na orientação do minimapa:
// horizontal = y, vertical = x (conferido com os NPCs de Devias e Lorencia sobre o minimapa do Fanz).
// Sem imagem do minimapa (build público), o fundo é liso; sem drops/imagens na fonte, o painel mostra só o que há.
import type { FarmSpot, MapMarker, Terrain } from "../lib/data";
import { monsterById, dropsByMonster, itemById } from "../lib/data";

interface Props { mapName: string; spots: FarmSpot[]; markers?: MapMarker[]; minimap?: string | null; terrain?: Terrain | null }
const { mapName, spots, markers = [], minimap = null, terrain = null } = Astro.props;

const KIND_ORDER: Record<string, number> = { ancient: 0, excellent: 1, socket: 2, normal: 3, unknown: 4 };
const MAX_DROPS = 10;
const monsterIds = [...new Set(spots.flatMap((s) => s.monsters.map((m) => m.monster_id)))];
const monsters = Object.fromEntries(monsterIds.map((id) => {
  const m = monsterById.get(id);
  const all = [...new Map((dropsByMonster.get(id) ?? []).map((d) => [d.item_id, d])).values()]
    .sort((a, b) => (KIND_ORDER[a.kind] ?? 9) - (KIND_ORDER[b.kind] ?? 9) || a.item_name.localeCompare(b.item_name));
  return [id, {
    name: m?.name ?? id, level: m?.level ?? null, hp: m?.hp ?? null, atk: m && m.atk_min != null ? [m.atk_min, m.atk_max] : null,
    def: m?.def ?? null, img: m?.image_url ?? null, page: !!m,
    drops: all.slice(0, MAX_DROPS).map((d) => ({ id: d.item_id, name: d.item_name, kind: d.kind, img: itemById.get(d.item_id)?.image_url ?? null, page: itemById.has(d.item_id) })),
    dropsTotal: all.length,
  }];
}));
const payload = {
  map: mapName,
  spots: spots.map((s, i) => ({ n: i + 1, x: s.x, y: s.y, box: [s.x_min, s.y_min, s.x_max, s.y_max], lv: [s.level_min, s.level_max], total: s.total, heat: s.heat ?? "mid",
    monsters: s.monsters.map((m) => [m.monster_id, m.count]) })),
  monsters,
};
const shownMarkers = markers.filter((m) => m.x != null && m.y != null && ["spot", "hot_spot", "gate", "warp"].includes(m.kind));
const radius = (total: number) => Math.min(8, 4.5 + Math.sqrt(total) / 3);
const HEAT_LABEL: Record<string, string> = { hot: "Hot spot", mid: "Mid spot", low: "Low spot", boss: "Boss spot" };
const heats = (["hot", "mid", "low", "boss"] as const).filter((h) => spots.some((s) => (s.heat ?? "mid") === h));
---
<div class="mx" data-mx>
  <div class="mx-layers" role="group" aria-label="Camadas do mapa">
    <label><input type="checkbox" data-layer="spots" checked /> Spots de farm ({spots.length})</label>
    {terrain && minimap && <label><input type="checkbox" data-layer="minimap" /> Imagem do minimapa</label>}
    {shownMarkers.some((m) => m.kind === "spot" || m.kind === "hot_spot") && <label><input type="checkbox" data-layer="game" checked /> <span class="mk-spot-i">▲</span> Spots do minimapa do jogo</label>}
    {shownMarkers.some((m) => m.kind === "gate" || m.kind === "warp") && <label><input type="checkbox" data-layer="gates" checked /> <span class="mk-gate-i">■</span> Portais</label>}
  </div>
  {heats.length > 0 && (
    <p class="mx-heat-legend">{heats.map((h) => <span><i class={`heat-dot-i heat-${h}`}></i>{HEAT_LABEL[h]}</span>)}</p>
  )}
  <div class="mx-body">
    <svg class:list={["mx-svg", { "has-minimap": minimap || terrain, "has-terrain": terrain }]} viewBox="0 0 256 256" role="img" aria-label={`Mapa de ${mapName} com spots de farm`}>
      <rect x="0" y="0" width="256" height="256" class="mx-bg" />
      {terrain && (
        <g class="mx-terrain">
          <path class="t-land" d={terrain.land} fill-rule="evenodd" />
          <path class="t-walk" d={terrain.walk} fill-rule="evenodd" />
          <path class="t-safe" d={terrain.safe} fill-rule="evenodd" />
        </g>
      )}
      {minimap && <g data-group="minimap" class:list={{ off: !!terrain }}><image href={minimap} x="0" y="0" width="256" height="256" preserveAspectRatio="none" referrerpolicy="no-referrer" /></g>}
      <g data-group="game">
        {shownMarkers.filter((m) => m.kind === "spot" || m.kind === "hot_spot").map((m) => (
          <path class={m.kind === "hot_spot" ? "mk-hot" : "mk-spot"} d={`M${m.y},${(m.x as number) - 4.5} L${(m.y as number) + 4},${(m.x as number) + 3.5} L${(m.y as number) - 4},${(m.x as number) + 3.5} Z`}><title>{m.name} ({m.x}, {m.y})</title></path>
        ))}
      </g>
      <g data-group="gates">
        {shownMarkers.filter((m) => m.kind === "gate" || m.kind === "warp").map((m) => (
          <rect class="mk-gate" x={(m.y as number) - 3} y={(m.x as number) - 3} width="6" height="6"><title>{m.name}{m.description ? ` — ${m.description}` : ""}</title></rect>
        ))}
      </g>
      <g data-group="spots">
        {spots.map((s, i) => (
          <rect class="mx-area" data-area={i + 1} x={s.y_min} y={s.x_min} width={Math.max(2, s.y_max - s.y_min)} height={Math.max(2, s.x_max - s.x_min)} />
        ))}
        {spots.map((s, i) => (
          <g class={`mx-spot heat-${s.heat ?? "mid"}`} data-spot={i + 1} tabindex="0" role="button" aria-label={`${HEAT_LABEL[s.heat ?? "mid"]} ${i + 1}: ${s.total} monstros (${s.monsters.map((m) => m.name).join(", ")})`}>
            <circle cx={s.y} cy={s.x} r={radius(s.total)} />
            <text x={s.y} y={s.x + 2.3} text-anchor="middle">x{s.total}</text>
          </g>
        ))}
      </g>
    </svg>
    <div class="mx-panel" data-panel aria-live="polite">
      <p class="muted">Toque num número do mapa (ou numa linha da tabela) para ver os monstros, os atributos e os drops do spot.</p>
    </div>
  </div>
  <script type="application/json" data-mx-data set:html={JSON.stringify(payload)} />
</div>

<script>
  type Data = {
    map: string;
    spots: { n: number; x: number; y: number; box: number[]; lv: (number | null)[]; total: number; heat: string; monsters: [string, number][] }[];
    monsters: Record<string, { name: string; level: number | null; hp: number | null; atk: number[] | null; def: number | null; img: string | null; page: boolean;
      drops: { id: string; name: string; kind: string; img: string | null; page: boolean }[]; dropsTotal: number }>;
  };
  const fmt = (n: number | null | undefined) => (n == null ? "—" : n.toLocaleString("pt-BR"));
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string);
  const img = (src: string | null, cls: string) => (src ? `<img class="${cls}" src="${esc(src)}" alt="" loading="lazy" referrerpolicy="no-referrer" />` : "");
  const KIND: Record<string, string> = { ancient: "ancient", excellent: "excellent", socket: "socket", normal: "normal" };

  for (const root of document.querySelectorAll<HTMLElement>("[data-mx]")) {
    const data = JSON.parse(root.querySelector("[data-mx-data]")!.textContent || "{}") as Data;
    const panel = root.querySelector<HTMLElement>("[data-panel]")!;

    function render(n: number) {
      const s = data.spots.find((x) => x.n === n);
      if (!s) return;
      root.querySelectorAll(".mx-spot").forEach((g) => g.classList.toggle("on", Number((g as HTMLElement).dataset.spot) === n));
      root.querySelectorAll(".mx-area").forEach((r) => r.classList.toggle("on", Number((r as SVGElement).dataset.area) === n));
      document.querySelectorAll("tr[data-spot-row]").forEach((tr) => tr.classList.toggle("on", Number((tr as HTMLElement).dataset.spotRow) === n));
      const lv = s.lv[0] == null ? "" : s.lv[0] === s.lv[1] ? ` · nível ${fmt(s.lv[0])}` : ` · nível ${fmt(s.lv[0])}–${fmt(s.lv[1])}`;
      const cards = s.monsters.map(([id, count]) => {
        const m = data.monsters[id];
        if (!m) return "";
        const name = m.page ? `<a href="/monstros/${id}/">${esc(m.name)}</a>` : esc(m.name);
        const stats = [`nv ${fmt(m.level)}`, `HP ${fmt(m.hp)}`, m.atk ? `dano ${fmt(m.atk[0])}–${fmt(m.atk[1])}` : "", m.def != null ? `def ${fmt(m.def)}` : ""].filter(Boolean).join(" · ");
        const drops = m.drops.length
          ? `<ul class="mx-drops">${m.drops.map((d) => `<li class="k-${KIND[d.kind] ?? "normal"}">${img(d.img, "mx-drop-img")}${d.page ? `<a href="/itens/${d.id}/">${esc(d.name)}</a>` : esc(d.name)}</li>`).join("")}</ul>
             ${m.dropsTotal > m.drops.length && m.page ? `<a class="mx-more" href="/monstros/${id}/#drops">ver os ${fmt(m.dropsTotal)} drops</a>` : ""}`
          : `<p class="muted mx-nodrops">Sem tabela de drops nesta fonte.</p>`;
        return `<article class="mx-card">
          <header>${img(m.img, "mx-mob-img")}<div><strong>${name}</strong> <span class="mx-count">×${count}</span><br><small>${stats}</small></div></header>
          ${drops}
        </article>`;
      }).join("");
      const heatName: Record<string, string> = { hot: "Hot spot", mid: "Mid spot", low: "Low spot", boss: "Boss spot" };
      panel.innerHTML = `<h3><span class="heat-tag heat-${s.heat}">${heatName[s.heat] ?? "Spot"}</span> (#${n})</h3>
        <p class="mx-sub">x${fmt(s.total)} monstros · coordenadas (${s.x}, ${s.y})${lv}</p>${cards}`;
      history.replaceState(null, "", `#spot-${n}`);
    }

    root.addEventListener("click", (e) => {
      const g = (e.target as Element).closest<SVGGElement>(".mx-spot");
      if (g) render(Number(g.dataset.spot));
    });
    root.addEventListener("keydown", (e) => {
      const g = (e.target as Element).closest<SVGGElement>(".mx-spot");
      if (g && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); render(Number(g.dataset.spot)); }
    });
    root.querySelectorAll<HTMLInputElement>("[data-layer]").forEach((box) => box.addEventListener("change", () => {
      root.querySelector<SVGGElement>(`[data-group="${box.dataset.layer}"]`)?.classList.toggle("off", !box.checked);
    }));
    document.querySelectorAll<HTMLElement>("tr[data-spot-row]").forEach((tr) => tr.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) return;
      render(Number(tr.dataset.spotRow));
      root.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    const fromHash = location.hash.match(/^#spot-(\d+)$/);
    if (fromHash) render(Number(fromHash[1]));
  }
</script>

<style is:global>
  .mx { margin: .5rem 0 1.25rem; }
  .mx-layers { display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .85rem; color: var(--muted); margin-bottom: .4rem; }
  .mx-body { display: grid; grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); gap: 1rem; align-items: start; }
  @media (max-width: 48rem) { .mx-body { grid-template-columns: 1fr; } }
  .mx-svg { width: 100%; height: auto; display: block; border-radius: .5rem; border: 1px solid var(--line); background: var(--panel); }
  .mx-bg { fill: var(--panel); }
  .has-terrain .mx-bg { fill: #0b0d12; }
  .t-land { fill: #2b2f3a; }
  .t-walk { fill: #c9c3a8; }
  .t-safe { fill: #6fa8dc; fill-opacity: .55; }
  .mx .off { display: none; }
  .mx-area { fill: #ffd166; fill-opacity: 0; stroke: none; pointer-events: none; }
  .mx-area.on { fill-opacity: .25; stroke: #ffd166; stroke-width: .8; }
  .mx-spot { cursor: pointer; outline: none; }
  /* Cores dos hot spots: hot vermelho, mid amarelo, low branco, boss laranja. */
  .mx-spot circle { stroke: #111; stroke-width: .7; }
  .heat-hot circle { fill: #ef4444; }
  .heat-mid circle { fill: #facc15; }
  .heat-low circle { fill: #f1f5f9; }
  .heat-boss circle { fill: #f59e0b; }
  .mx-spot text { fill: #111; font-size: 5.2px; font-weight: 800; pointer-events: none; }
  .mx-spot.heat-hot text { fill: #fff; }
  .mx-spot:hover circle, .mx-spot:focus circle { stroke: #fff; stroke-width: 1.4; }
  .mx-spot.on circle { stroke: #22d3ee; stroke-width: 1.8; }
  .mx-heat-legend { display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .8rem; color: var(--muted); margin: 0 0 .4rem; }
  .heat-dot-i { display: inline-block; width: .75rem; height: .75rem; border-radius: 50%; border: 1px solid #111; margin-right: .3rem; vertical-align: -1px; }
  .heat-dot-i.heat-hot { background: #ef4444; } .heat-dot-i.heat-mid { background: #facc15; }
  .heat-dot-i.heat-low { background: #f1f5f9; } .heat-dot-i.heat-boss { background: #f59e0b; }
  .mx-sub { margin: -.25rem 0 .6rem; color: var(--muted); font-size: .9rem; }
  .mk-spot { fill: #22c55e; stroke: #000; stroke-width: .5; } .mk-hot { fill: #ef4444; stroke: #000; stroke-width: .5; }
  .mk-gate { fill: #38bdf8; stroke: #000; stroke-width: .5; }
  .mk-spot-i { color: #22c55e; } .mk-gate-i { color: #38bdf8; }
  .mx-panel { min-width: 0; }
  .mx-panel h3 { margin: 0 0 .5rem; font-size: 1rem; }
  .mx-card { background: var(--panel); border: 1px solid var(--line); border-radius: .5rem; padding: .6rem .75rem; margin-bottom: .6rem; }
  .mx-card header { display: flex; gap: .6rem; align-items: center; }
  .mx-mob-img { width: 52px; height: 52px; object-fit: contain; background: #12131a; border-radius: .4rem; flex: none; }
  .mx-count { color: var(--muted); }
  .mx-drops { list-style: none; padding: 0; margin: .5rem 0 0; display: flex; flex-wrap: wrap; gap: .3rem; }
  .mx-drops li { display: inline-flex; align-items: center; gap: .3rem; font-size: .8rem; padding: .1rem .5rem .1rem .2rem; border: 1px solid var(--line); border-radius: 1rem; }
  .mx-drops li.k-excellent { border-color: #15803d; } .mx-drops li.k-ancient { border-color: #b45309; } .mx-drops li.k-socket { border-color: #7e22ce; }
  .mx-drop-img { width: 20px; height: 20px; object-fit: contain; }
  .mx-more { display: inline-block; margin-top: .35rem; font-size: .85rem; }
  .mx-nodrops { margin: .4rem 0 0; font-size: .85rem; }
  tr[data-spot-row] { cursor: pointer; }
  tr[data-spot-row].on td { background: color-mix(in srgb, var(--accent) 12%, transparent); }
</style>
