---
// Barra de mapas da área de spots (como no Guide MU Online): os mapas na ordem do guia (por nível), o atual em
// destaque. As zonas (andares, áreas) do mapa escolhido ficam na segunda linha, dentro do MapExplorer.
import { spotsUrl } from "../lib/data";
import { spotBarGroups } from "../lib/view";

interface Props { mapId?: string }
const { mapId } = Astro.props;
const { groups, others } = spotBarGroups();
const active = groups.find((g) => g.entries.some((e) => e.map_id === mapId));
const inOthers = !active && others.some((m) => m.id === mapId);
---
{groups.length > 0 && (
  <nav class="spotbar" aria-label="Mapas">
    <div class="spotbar-track" data-spotbar>
      {groups.map((g) => <a href={spotsUrl(g.href)} aria-current={g === active ? "page" : undefined}>{g.name}</a>)}
      {others.length > 0 && <a href="/spots/#outros" aria-current={inOthers ? "page" : undefined}>Outros</a>}
    </div>
  </nav>
)}
<script>
  // Deixa o mapa atual visível na barra (ela rola na horizontal).
  for (const bar of document.querySelectorAll<HTMLElement>("[data-spotbar]")) {
    const on = bar.querySelector<HTMLElement>("[aria-current]");
    if (on) bar.scrollLeft = on.offsetLeft - bar.clientWidth / 2 + on.offsetWidth / 2;
  }
</script>
<style>
  .spotbar { margin: -.5rem 0 1rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--bg-2); }
  .spotbar-track { display: flex; gap: .3rem; padding: .45rem .8rem; overflow-x: auto; scrollbar-width: none; scroll-behavior: smooth;
    mask-image: linear-gradient(90deg, transparent, #000 1rem, #000 calc(100% - 1rem), transparent); }
  .spotbar a { flex: none; padding: .32rem .7rem; border-radius: .45rem; border: 1px solid var(--line-2); color: var(--muted); text-decoration: none; font: 700 .76rem/1.3 var(--sans); letter-spacing: .05em; text-transform: uppercase; white-space: nowrap; }
  .spotbar a:hover { color: var(--fg); border-color: rgba(214,165,74,.5); }
  .spotbar a[aria-current] { color: var(--accent-2); background: var(--panel-2); border-color: var(--accent); }
</style>
