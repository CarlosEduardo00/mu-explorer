---
// Minimapa esquemático (256 × 256 casas) com as áreas dos spots; sem imagem do jogo.
import type { FarmSpot, MapMarker } from "../lib/data";
interface Props { spots: FarmSpot[]; label: string; markers?: MapMarker[] }
const { spots, label, markers = [] } = Astro.props;
const shown = markers.filter((m) => m.x != null && m.y != null && (m.kind === "spot" || m.kind === "hot_spot" || m.kind === "gate"));
const SIZE = 256;
---
<svg class="spot-map" viewBox={`0 0 ${SIZE} ${SIZE}`} role="img" aria-label={label}>
  <rect x="0" y="0" width={SIZE} height={SIZE} class="spot-map-bg" />
  {spots.map((s, i) => (
    <g>
      <rect x={s.x_min} y={s.y_min} width={Math.max(2, s.x_max - s.x_min)} height={Math.max(2, s.y_max - s.y_min)} class="spot-area" />
      <circle cx={s.x} cy={s.y} r="3" class="spot-dot" />
      <text x={s.x + 4} y={s.y - 4} class="spot-label">{i + 1}</text>
    </g>
  ))}
  {shown.map((m) => m.kind === "gate"
    ? <rect x={(m.x as number) - 3} y={(m.y as number) - 3} width="6" height="6" class="mk-gate"><title>{m.name}</title></rect>
    : <path d={`M${m.x},${(m.y as number) - 5} L${(m.x as number) + 4},${(m.y as number) + 4} L${(m.x as number) - 4},${(m.y as number) + 4} Z`} class={m.kind === "hot_spot" ? "mk-hot" : "mk-spot"}><title>{m.name}</title></path>)}
</svg>
{shown.length > 0 && <p class="mk-legend"><span class="mk-spot-i">▲</span> spot marcado no minimapa do jogo · <span class="mk-hot-i">▲</span> hot spot · <span class="mk-gate-i">■</span> portal</p>}
<style>
  .spot-map { width: 100%; max-width: 22rem; height: auto; display: block; margin: .5rem 0 1rem; }
  .spot-map-bg { fill: var(--panel); stroke: var(--line); }
  .spot-area { fill: var(--accent); fill-opacity: .12; stroke: var(--accent); stroke-opacity: .5; stroke-width: .6; }
  .spot-dot { fill: var(--accent); }
  .spot-label { fill: var(--fg); font-size: 9px; font-weight: 600; }
  .mk-spot { fill: #15803d; } .mk-hot { fill: #dc2626; } .mk-gate { fill: #0369a1; }
  .mk-legend { font-size: .8rem; color: var(--muted); margin: -.5rem 0 1rem; }
  .mk-spot-i { color: #15803d; } .mk-hot-i { color: #dc2626; } .mk-gate-i { color: #0369a1; }
</style>
