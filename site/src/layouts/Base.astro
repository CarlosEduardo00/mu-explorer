---
import { sources, datasetName, guides, skills } from "../lib/data";
import Flag from "../components/Flag.astro";
import Icon from "../components/Icon.astro";

/** titleEn: título em inglês quando ele não sai da tradução da interface (ex.: guias, que têm o título original). */
interface Props { title: string; titleEn?: string; description?: string; wide?: boolean }
const { title, titleEn, description = "Itens, monstros, mapas, spots de farm e builds de MU Online.", wide = false } = Astro.props;
const nav = [
  { href: "/itens/", label: "Itens" },
  { href: "/monstros/", label: "Monstros" },
  { href: "/mapas/", label: "Mapas" },
  { href: "/spots/", label: "Spots" },
  { href: "/npcs/", label: "NPCs" },
  { href: "/builds/", label: "Builds" },
  ...(skills.length ? [{ href: "/skills/", label: "Skills" }] : []),
  ...(guides.length ? [{ href: "/guias/", label: "Guias" }] : []),
  { href: "/planner/", label: "Planner" },
];
const path = Astro.url.pathname;
// Celular (como no hyrule-explorer): barra de abas fixa embaixo com as seções mais usadas e "Mais" com o resto.
const TABS = [
  { href: "/itens/", label: "Itens", icon: "items" },
  { href: "/monstros/", label: "Monstros", icon: "monsters" },
  { href: "/spots/", label: "Spots", icon: "spots" },
  { href: "/builds/", label: "Builds", icon: "builds" },
];
const MORE = [
  ...(skills.length ? [{ href: "/skills/", label: "Skills", icon: "skills" }] : []),
  ...(guides.length ? [{ href: "/guias/", label: "Guias", icon: "guides" }] : []),
  { href: "/mapas/", label: "Mapas", icon: "maps" },
  { href: "/npcs/", label: "NPCs", icon: "npcs" },
  { href: "/planner/", label: "Planner", icon: "planner" },
  { href: "/api/", label: "API e dados abertos", icon: "api" },
];
const moreActive = MORE.some((m) => path.startsWith(m.href));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title === "MU Explorer" ? title : `${title} · MU Explorer`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0e13" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 2 30 16 16 30 2 16Z' fill='%23d6a54a'/%3E%3Cpath d='M16 8 24 16 16 24 8 16Z' fill='%230c0e13'/%3E%3C/svg%3E" />
    {titleEn && <meta name="mu:title-en" content={titleEn} />}
    <script is:inline>
      // Idioma escolhido antes de pintar a página: em inglês, a página fica escondida até a tradução (lib/i18n-client)
      // terminar, para não piscar o português (no máximo 2,5 s, se o script falhar).
      try {
        if (localStorage.getItem("mu-explorer:lang") === "en") {
          const h = document.documentElement;
          h.dataset.lang = "en"; h.classList.add("i18n-wait");
          setTimeout(() => h.classList.remove("i18n-wait"), 2500);
        }
      } catch {}
    </script>
    <link rel="preload" href="/fonts/cinzel-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="top">
      <div class="top-in">
        <a class="brand" href="/" aria-label="MU Explorer, início">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 30 16 16 30 2 16Z" /><path class="cut" d="M16 8 24 16 16 24 8 16Z" /></svg>
          <span>MU Explorer</span>
        </a>
        <nav aria-label="Seções">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <button type="button" class="icon-btn search-toggle" data-search-toggle aria-label="Buscar no site" aria-expanded="false"><Icon name="search" /></button>
        <div class="lang-pick" role="group" aria-label="Idioma do site">
          <button type="button" data-lang-set="pt-BR" aria-pressed="true" title="Português" data-i18n="off"><Flag lang="pt-BR" /><span class="sr">Português</span></button>
          <button type="button" data-lang-set="en" aria-pressed="false" title="English"><Flag lang="en" /><span class="sr">English</span></button>
        </div>
        <div class="gsearch" data-gsearch>
          <input type="search" placeholder="Buscar item, monstro, mapa…" aria-label="Buscar no site" autocomplete="off" />
          <ul class="gsearch-results" role="listbox" hidden></ul>
        </div>
      </div>
    </header>
    <nav class="tabbar" aria-label="Seções">
      {TABS.map((t) => <a href={t.href} aria-current={path.startsWith(t.href) ? "page" : undefined}><Icon name={t.icon} /><span>{t.label}</span></a>)}
      <button type="button" class:list={["tab-more", { on: moreActive }]} data-more aria-expanded="false" aria-controls="more-sheet"><Icon name="more" /><span>Mais</span></button>
    </nav>
    <div class="sheet-backdrop" data-sheet-backdrop hidden></div>
    <div class="more-sheet" id="more-sheet" role="dialog" aria-label="Mais seções" hidden>
      <ul>
        {MORE.map((m) => <li><a href={m.href} aria-current={path.startsWith(m.href) ? "page" : undefined}><Icon name={m.icon} /><span>{m.label}</span></a></li>)}
      </ul>
    </div>
    <main class:list={[{ wide }]}><slot /></main>
    <footer>
      <div class="foot-in">
        <p>Projeto de fãs, sem vínculo com a Webzen. MU Online é marca da Webzen Inc.</p>
        {sources.length > 0 && (
          <p class="credits">
            Dados e imagens:{" "}
            {sources.map((s, i) => <>{i > 0 && " · "}<a href={s.url}>{s.name}</a></>)}.
            Publicados com autorização; o conteúdo continua sendo dos autores de cada fonte.
            {datasetName !== "combined" && <> Conjunto “{datasetName}”.</>}
          </p>
        )}
        <p class="credits"><a href="/api/">API e dados abertos</a> · fontes Cinzel e Source Sans 3 (SIL OFL)</p>
        <p class="credits only-en">Em inglês, os textos são traduções nossas da interface; nomes e textos do jogo ficam como nas fontes.</p>
      </div>
    </footer>
    <script>
      // Busca global: carrega o índice na primeira interação e mostra até 10 resultados (nome começa > contém).
      type Entry = [string, string, string, string | null, string, string?];
      const box = document.querySelector<HTMLElement>("[data-gsearch]")!;
      const input = box.querySelector("input")!;
      const list = box.querySelector("ul")!;
      let index: Entry[] | null = null;
      let loading: Promise<void> | null = null;
      let active = -1;
      const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
      const load = () => (loading ??= fetch("/data/search.json").then((r) => r.json()).then((d: Entry[]) => { index = d; }));
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
      function render() {
        const q = norm(input.value.trim());
        active = -1;
        if (!q || !index) { list.hidden = true; list.innerHTML = ""; return; }
        const starts: Entry[] = [], has: Entry[] = [];
        for (const e of index) {
          const n = norm(e[5] ? `${e[1]} ${e[5]}` : e[1]);   // guias: nome em português e o original
          if (n.startsWith(q) || (e[5] && norm(e[5]).startsWith(q))) starts.push(e); else if (n.includes(q)) has.push(e);
          if (starts.length >= 10) break;
        }
        const found = [...starts, ...has].slice(0, 10);
        list.innerHTML = found.length
          ? found.map((e) => `<li role="option"><a href="${e[2]}">${e[3] ? `<img src="${e[3]}" alt="" loading="lazy">` : `<span class="gs-ph"></span>`}<span><b>${e[5] ? `<span class="tx" lang="pt-BR">${esc(e[1])}</span><span class="tx" lang="en">${esc(e[5])}</span>` : esc(e[1])}</b><small>${esc(e[0])}${e[4] ? ` · ${esc(e[4])}` : ""}</small></span></a></li>`).join("")
          : `<li class="gs-empty">Nada encontrado.</li>`;
        list.hidden = false;
      }
      input.addEventListener("focus", () => { load(); });
      input.addEventListener("input", () => { load().then(render); });
      input.addEventListener("keydown", (ev) => {
        const links = [...list.querySelectorAll("a")];
        if (ev.key === "ArrowDown" || ev.key === "ArrowUp") {
          ev.preventDefault();
          active = Math.max(0, Math.min(links.length - 1, active + (ev.key === "ArrowDown" ? 1 : -1)));
          links.forEach((a, i) => a.classList.toggle("on", i === active));
        } else if (ev.key === "Enter" && links.length) {
          ev.preventDefault();
          location.href = (links[Math.max(active, 0)] as HTMLAnchorElement).href;
        } else if (ev.key === "Escape") { list.hidden = true; input.blur(); }
      });
      // Celular: a busca fica atrás do botão da lupa no topo (abre uma linha embaixo do cabeçalho).
      const top = document.querySelector<HTMLElement>(".top")!;
      const toggle = document.querySelector<HTMLButtonElement>("[data-search-toggle]")!;
      const searching = (on: boolean) => {
        top.classList.toggle("searching", on);
        toggle.setAttribute("aria-expanded", String(on));
        if (on) { input.focus(); load(); } else list.hidden = true;
      };
      toggle.addEventListener("click", () => searching(!top.classList.contains("searching")));
      document.addEventListener("click", (ev) => {
        const t = ev.target as Node;
        if (!box.contains(t)) list.hidden = true;
        if (!box.contains(t) && !toggle.contains(t) && top.classList.contains("searching")) searching(false);
      });
      // Celular: "Mais" abre um painel acima da barra de abas com as outras seções.
      const moreBtn = document.querySelector<HTMLButtonElement>("[data-more]")!;
      const sheet = document.getElementById("more-sheet")!;
      const backdrop = document.querySelector<HTMLElement>("[data-sheet-backdrop]")!;
      const more = (on: boolean) => { sheet.hidden = !on; backdrop.hidden = !on; moreBtn.setAttribute("aria-expanded", String(on)); };
      moreBtn.addEventListener("click", () => more(sheet.hidden));
      backdrop.addEventListener("click", () => more(false));
      document.addEventListener("keydown", (ev) => { if (ev.key === "Escape") { more(false); if (top.classList.contains("searching")) searching(false); } });
      // Idioma do site (topo e guias): fica guardado no navegador. Em inglês, lib/i18n-client traduz a página; para
      // voltar ao português, a página recarrega (o texto original volta inteiro).
      const html = document.documentElement;
      const english = () => import("../lib/i18n-client").then((m) => m.start()).catch(() => html.classList.remove("i18n-wait"));
      const pressed = (lang: string) =>
        document.querySelectorAll<HTMLButtonElement>("[data-lang-set]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.langSet === lang)));
      const setLang = (lang: string) => {
        const was = html.dataset.lang === "en" ? "en" : "pt-BR";
        try { localStorage.setItem("mu-explorer:lang", lang); } catch { /* sem armazenamento */ }
        if (lang === was) return;
        if (lang === "pt-BR") { location.reload(); return; }
        html.dataset.lang = "en";
        pressed("en");
        english();
      };
      document.querySelectorAll<HTMLButtonElement>("[data-lang-set]").forEach((b) => b.addEventListener("click", () => setLang(b.dataset.langSet!)));
      pressed(html.dataset.lang === "en" ? "en" : "pt-BR");
      if (html.dataset.lang === "en") english();
      document.addEventListener("keydown", (ev) => {
        const tag = document.activeElement?.tagName;
        if (ev.key === "/" && tag !== "INPUT" && tag !== "TEXTAREA" && tag !== "SELECT") { ev.preventDefault(); input.focus(); }
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: "Cinzel"; src: url("/fonts/cinzel-latin.woff2") format("woff2"); font-weight: 400 900; font-display: swap; }
  @font-face { font-family: "Source Sans 3"; src: url("/fonts/source-sans-3-latin.woff2") format("woff2"); font-weight: 200 900; font-display: swap; }
  /* Tema escuro, no clima do jogo: pedra azulada, ouro nos destaques; cores de qualidade como no MU. */
  :root {
    color-scheme: dark;
    --bg: #0c0e13; --bg-2: #10131a; --panel: #151922; --panel-2: #1b2030; --line: #262c3b; --line-2: #343c50;
    --fg: #ece6d6; --muted: #9298a6; --accent: #d6a54a; --accent-2: #f2cd7d; --link: #e7bb63;
    --g-normal: #e8e6df; --g-excellent: #5ee38a; --g-ancient: #4cc3ff; --g-socket: #c792ff; --g-siege: #ff9f4a;
    --radius: .6rem; --shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 6px 20px rgba(0,0,0,.25);
    --display: "Cinzel", "Trajan Pro", Georgia, serif;
    --sans: "Source Sans 3", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    /* Volume de monstros do spot (alto, médio, baixo) e chefe: as mesmas cores no mapa, nas etiquetas e nas listas. */
    --heat-hot: #fbbf24; --heat-hot-fg: #1c1303; --heat-mid: #2dd4bf; --heat-mid-fg: #04201c;
    --heat-low: #9aa6b8; --heat-low-fg: #0b1220; --heat-boss: #fb7185; --heat-boss-fg: #2a0610;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  /* Textos com tradução: aparece a língua escolhida (padrão português). */
  :root:not([data-lang="en"]) .tx[lang="en"], :root[data-lang="en"] .tx[lang="pt-BR"] { display: none !important; }
  :root:not([data-lang="en"]) .only-en { display: none; }
  html.i18n-wait body { visibility: hidden; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .lang-pick { display: inline-flex; gap: .2rem; flex: none; }
  .lang-pick button { display: inline-flex; padding: .3rem .35rem; border: 1px solid transparent; border-radius: .4rem; background: none; cursor: pointer; opacity: .5; }
  .lang-pick button:hover { opacity: .85; }
  .lang-pick button[aria-pressed="true"] { opacity: 1; border-color: var(--line-2); background: var(--panel); }
  .lang-switch { display: inline-flex; border: 1px solid var(--line-2); border-radius: .5rem; overflow: hidden; }
  .lang-switch button { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .7rem; border: 0; background: var(--panel); color: var(--muted); font: 600 .85rem/1.3 var(--sans); cursor: pointer; }
  .lang-switch button + button { border-left: 1px solid var(--line-2); }
  .lang-switch button[aria-pressed="true"] { background: var(--panel-2); color: var(--accent-2); }
  html { scroll-padding-top: 5rem; }
  body {
    margin: 0; min-height: 100vh; display: flex; flex-direction: column; color: var(--fg);
    background: radial-gradient(1200px 500px at 50% -200px, #1a2033 0%, transparent 70%), var(--bg);
    font: 16.5px/1.55 var(--sans); font-optical-sizing: auto; -webkit-font-smoothing: antialiased;
  }
  a { color: var(--link); text-decoration-color: rgba(231,187,99,.35); text-underline-offset: 2px; }
  a:hover { color: var(--accent-2); text-decoration-color: currentColor; }
  img { max-width: 100%; }
  main { width: 100%; max-width: 64rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; flex: 1; }
  main.wide { max-width: 80rem; }
  h1, h2, h3 { font-family: var(--display); letter-spacing: .02em; line-height: 1.2; }
  h1 { margin: 0 0 .35rem; font-size: clamp(1.6rem, 4vw, 2.2rem); color: var(--accent-2); font-weight: 700; }
  h2 { margin: 2.25rem 0 .75rem; font-size: 1.2rem; font-weight: 700; display: flex; align-items: center; gap: .6rem; }
  h2::after { content: ""; flex: 1; height: 1px; background: linear-gradient(90deg, var(--line-2), transparent); }
  h3 { margin: 0 0 .5rem; font-size: 1rem; }
  .lead { color: var(--muted); font-size: 1.05rem; margin: .25rem 0 1rem; max-width: 46rem; }
  .muted { color: var(--muted); }
  .small { font-size: .85rem; }

  /* Topo */
  .top { position: sticky; top: 0; z-index: 20; background: rgba(12,14,19,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .top::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: .5; }
  .top-in { max-width: 80rem; margin: 0 auto; padding: .55rem 1rem; display: flex; align-items: center; gap: .5rem 1.5rem; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; color: var(--accent-2); font-family: var(--display); font-weight: 700; font-size: 1.15rem; letter-spacing: .04em; }
  .brand svg { width: 1.4rem; height: 1.4rem; } .brand svg path { fill: var(--accent); } .brand svg .cut { fill: var(--bg); }
  .top nav { display: flex; gap: .15rem; overflow-x: auto; scrollbar-width: none; }
  .top nav a { padding: .35rem .65rem; border-radius: .4rem; text-decoration: none; color: var(--muted); white-space: nowrap; font-weight: 500; }
  .top nav a:hover { color: var(--fg); background: var(--panel); }
  .top nav a[aria-current] { color: var(--accent-2); background: var(--panel-2); }
  /* a busca encolhe antes de o topo quebrar em duas linhas (Skills, Guias e o seletor de idioma no mesmo topo) */
  .gsearch { position: relative; margin-left: auto; flex: 1 1 14rem; max-width: 22rem; }
  .gsearch input { width: 100%; padding: .45rem .75rem; font-size: .9rem; }
  .gsearch-results { position: absolute; right: 0; left: 0; top: calc(100% + .35rem); margin: 0; padding: .3rem; list-style: none; background: var(--panel); border: 1px solid var(--line-2); border-radius: .6rem; box-shadow: 0 12px 30px rgba(0,0,0,.5); max-height: 70vh; overflow: auto; }
  .gsearch-results a { display: flex; gap: .6rem; align-items: center; padding: .35rem .45rem; border-radius: .4rem; text-decoration: none; color: var(--fg); }
  .gsearch-results a:hover, .gsearch-results a.on { background: var(--panel-2); }
  .gsearch-results img, .gs-ph { width: 32px; height: 32px; object-fit: contain; flex: none; border-radius: .3rem; background: var(--bg); }
  .gsearch-results span { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .gsearch-results b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gsearch-results small { color: var(--muted); }
  .gs-empty { padding: .5rem; color: var(--muted); }
  .top .lang-pick { order: 4; }
  .icon { width: 1.25rem; height: 1.25rem; flex: none; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--line-2); border-radius: .6rem; background: var(--panel); color: var(--fg); cursor: pointer; }
  .icon-btn[aria-expanded="true"] { color: var(--accent-2); border-color: var(--accent); }
  .tabbar, .more-sheet, .sheet-backdrop, .search-toggle { display: none; }

  /* Celular (como no hyrule-explorer): topo de uma linha (marca, lupa, idioma), seções numa barra de abas fixa
     embaixo, "Mais" num painel que sobe; a área segura do iPhone fica livre (env(safe-area-inset-*)). */
  @media (max-width: 52rem) {
    .top { padding-top: env(safe-area-inset-top); }
    .top-in { flex-wrap: nowrap; gap: .5rem; padding: .4rem max(1rem, env(safe-area-inset-right)) .4rem max(1rem, env(safe-area-inset-left)); }
    .top nav { display: none; }
    .search-toggle { display: inline-flex; margin-left: auto; }
    .gsearch { display: none; }
    .top.searching .gsearch { display: block; position: absolute; left: 0; right: 0; top: 100%; width: auto; margin: 0; padding: .55rem 1rem .7rem; background: rgba(12,14,19,.98); border-bottom: 1px solid var(--line); }
    .top.searching .gsearch input { font-size: 1rem; padding: .65rem .85rem; }
    .top.searching .gsearch-results { left: 1rem; right: 1rem; max-height: calc(100dvh - 12rem); }
    .gsearch-results a { min-height: 2.9rem; }
    .lang-pick button { padding: .45rem .5rem; }
    .tabbar { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      padding: .3rem max(.25rem, env(safe-area-inset-right)) calc(.3rem + env(safe-area-inset-bottom)) max(.25rem, env(safe-area-inset-left));
      background: rgba(14,16,22,.97); backdrop-filter: blur(10px); border-top: 1px solid var(--line-2); box-shadow: 0 -8px 24px rgba(0,0,0,.35); }
    .tabbar a, .tabbar button { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15rem; min-height: 3.3rem;
      border: 0; border-radius: .7rem; background: none; color: var(--muted); font: 600 .72rem/1.1 var(--sans); text-decoration: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .tabbar .icon { width: 1.5rem; height: 1.5rem; }
    .tabbar [aria-current], .tabbar .on, .tabbar [aria-expanded="true"] { color: var(--accent-2); }
    .tabbar [aria-current]::before, .tabbar .on::before { content: ""; position: absolute; top: -.3rem; left: 28%; right: 28%; height: 2px; border-radius: 2px; background: var(--accent); }
    .tabbar a:active, .tabbar button:active { background: var(--panel); }
    .sheet-backdrop:not([hidden]) { display: block; position: fixed; inset: 0; z-index: 38; background: rgba(0,0,0,.5); }
    .more-sheet:not([hidden]) { display: block; position: fixed; left: .5rem; right: .5rem; bottom: calc(4.4rem + env(safe-area-inset-bottom)); z-index: 45; padding: .5rem;
      border-radius: 1rem; border: 1px solid var(--line-2); background: var(--panel); box-shadow: 0 -12px 32px rgba(0,0,0,.55); animation: sheet-up .16s ease-out; }
    .more-sheet ul { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; margin: 0; padding: 0; list-style: none; }
    .more-sheet a { display: flex; align-items: center; gap: .65rem; min-height: 3.2rem; padding: .55rem .8rem; border-radius: .75rem; background: var(--panel-2); color: var(--fg); text-decoration: none; font-weight: 600; }
    .more-sheet a[aria-current] { color: var(--accent-2); box-shadow: inset 0 0 0 1px var(--accent); }
