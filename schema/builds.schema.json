{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carloseduardo00/mu-explorer/schema/builds.schema.json",
  "title": "Builds",
  "description": "Builds prontas do planner (data/curated/builds.json): curadoria nossa, escrita como regras de distribuição por fase de nível. Não copia distribuições de guias; cita as referências.",
  "type": "object",
  "additionalProperties": false,
  "required": ["builds"],
  "properties": {
    "builds": {
      "type": "array",
      "items": { "$ref": "#/$defs/build" }
    }
  },
  "$defs": {
    "stat": { "enum": ["str", "agi", "vit", "ene", "cmd"] },
    "target": {
      "description": "Meta do atributo total (com a base): número, \"gear\" (o que o equipamento exige) ou proporcional ao nível.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "const": "gear" },
        {
          "type": "object", "additionalProperties": false, "required": ["per_level"],
          "properties": { "per_level": { "type": "number", "exclusiveMinimum": 0 } }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_level", "fill", "split"],
      "properties": {
        "from_level": { "type": "integer", "minimum": 1 },
        "fill": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["stat", "to"],
            "properties": { "stat": { "$ref": "#/$defs/stat" }, "to": { "$ref": "#/$defs/target" } }
          }
        },
        "split": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/stat" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class_id", "name", "role", "summary", "phases", "notes", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "class_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["pvm", "pvp", "suporte", "híbrida"] },
        "summary": { "type": "string", "minLength": 1 },
        "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/phase" } },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "url"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https?://" } }
          }
        }
      }
    }
  }
}
